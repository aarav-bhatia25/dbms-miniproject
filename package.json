{
  "name": "caneflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A PostgreSQL-driven sugarcane irrigation and water allocation mini project",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
